{
  "context-guard": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/hooks/chat_lifecycle.py auto-archive --hook",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/hooks/project_activity_badge.py --event PreInvocation",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/hooks/context_guard.py",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/hooks/pre_tool_guard_notice.py",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|replace_file_content|multi_replace_file_content|write_to_file|write_file|edit_file|call_mcp_tool|run_workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/hooks/pre_tool_guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/hooks/cl_title_on_upload.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/hooks/stop_guard.py",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/hooks/project_activity_badge.py --event Stop",
        "timeout": 5
      },
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/hooks/chat_lifecycle.py auto-archive --hook",
        "timeout": 5
      }
    ]
  }
}
